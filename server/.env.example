PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/paysaathi?schema=public
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

# OTP provider — MSG91 (primary, India-focused)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id

# OTP provider — Twilio Verify (fallback)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SID=your-twilio-verify-service-sid

# Redis (required for Socket.io scaling)
REDIS_URL=redis://localhost:6379

# Cloudinary (avatar storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your-expo-access-token

# Safety / rate limiting
REPORT_AUTO_SUSPEND_THRESHOLD=5
OTP_EXPIRY_MINUTES=10
OTP_MAX_PER_PHONE_PER_HOUR=3

# CORS — comma-separated origins (leave * for development)
ALLOWED_ORIGINS=*

LOG_LEVEL=debug
NODE_ENV=development
